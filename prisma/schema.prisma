// PostgreSQL / Prisma ORM. 데모용 축소 스키마 (docs/MEETING_MATERIAL/MVP/FOR_Draw_Io/erd-mvp.drawio 기준, 7개 테이블).
// 기존 20개 테이블 버전은 docs/ARCHIVE/FULL_20_TABLES/schema-full-20-tables.prisma.txt 에 보관했다.
//
// ID와 사용자 테이블명은 BE 구현(BE/src/main/resources/db/migration/V1__init.sql)에 맞췄다:
//  - 모든 ID는 BigInt 자동 증가 (Java Long, PostgreSQL BIGINT identity). Prisma의 Int는 32비트라 BigInt를 쓴다.
//  - User 모델의 테이블 이름은 users (@@map).
// 나머지 테이블·컬럼 이름은 아직 Prisma 기본값(모델명, camelCase)이라 BE의 snake_case 테이블과 다르다.
// 이 스키마로 BE DB에 바로 붙으려면 모든 모델에 @@map, 컬럼에 @map이 더 필요하다(스키마 기준 결정 후 처리).
//
// 데모 단순화 (실서비스 전환 시 다시 넣을 것):
//  - 개인 데이터 암호화 없음 (금액은 평문 Int 원 단위)
//  - soft delete(deletedAt) 없음
//  - 동의 이력은 User의 termsVersion/consentedAt 한 쌍으로 축소 (철회·재동의 이력 없음)
//  - 급여명세서 원본 파일은 저장하지 않는다 (추출 직후 삭제). 추출된 항목과 금액만 저장한다.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// OCR 표준 필드 14개 (급여명세서 OCR 파트 명세 기준, 월 금액).
enum PayslipFieldKey {
  base_salary
  meal_allowance
  car_allowance
  overtime_pay
  bonus
  payment_total
  national_pension
  health_insurance
  long_term_care
  employment_insurance
  income_tax
  local_income_tax
  deduction_total
  net_pay
}

// ok: 추출·검증 통과 / needs_review: 신뢰도 0.8 미만 또는 검증 실패 / missing: 미발견(value는 null).
enum FieldStatus {
  OK
  NEEDS_REVIEW
  MISSING
}

enum RuleStatus {
  DRAFT
  VERIFIED
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum TaskStatus {
  TODO
  DONE
  NOT_APPLICABLE
}

model User {
  id            BigInt     @id @default(autoincrement())
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  authSubject   String     @unique
  // 감면/공제 점검 입력값. 직접 입력받을지 여부는 팀 결정 사항(미정).
  birthYear     Int?
  joinedOn      DateTime?  @db.Date
  isSmeEmployee Boolean?
  termsVersion  String?
  consentedAt   DateTime?  @db.Timestamptz(3)
  payslips      Payslip[]
  tasks         UserTask[]

  // user는 PostgreSQL 예약어라 실제 테이블 이름은 users (BE V1__init.sql과 같음)
  @@map("users")
}

model Payslip {
  id            BigInt         @id @default(autoincrement())
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  userId        BigInt
  // 귀속 월. 예: "2026-03"
  payPeriod     String
  companyName   String?
  // 표준 필드로 매핑하지 못한 원문 항목 [{ label, amount }]
  unmappedItems Json           @default("[]")
  // 검증 경고 [{ field, reason }]
  warnings      Json           @default("[]")
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  fields        PayslipField[]
  findings      CheckFinding[]

  @@index([userId, payPeriod])
}

model PayslipField {
  id            BigInt          @id @default(autoincrement())
  payslipId     BigInt
  key           PayslipFieldKey
  // 월 기준 정수 원. missing이면 null.
  value         Int?
  confidence    Float?
  sourceLabel   String?
  status        FieldStatus
  // 사용자가 확인·수정한 값만 규칙 엔진으로 넘긴다.
  userConfirmed Boolean         @default(false)
  payslip       Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@unique([payslipId, key])
}

model TaxRuleVersion {
  id         BigInt         @id @default(autoincrement())
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  taxYear    Int
  version    String
  status     RuleStatus     @default(DRAFT)
  // 점검 규칙 파라미터. 요건이 늘어나면 별도 테이블로 분리한다.
  parameters Json
  sourceUrl  String?
  verifiedAt DateTime?      @db.Timestamptz(3)
  findings   CheckFinding[]

  @@unique([taxYear, version])
}

model CheckFinding {
  id               BigInt         @id @default(autoincrement())
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  payslipId        BigInt
  taxRuleVersionId BigInt
  ruleCode         String
  severity         Severity
  message          String
  // 항상 예상치 안내. 계산/판정 결과를 확정처럼 보여주지 않는다.
  isEstimate       Boolean        @default(true)
  payslip          Payslip        @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  taxRuleVersion   TaxRuleVersion @relation(fields: [taxRuleVersionId], references: [id], onDelete: Restrict)
  tasks            UserTask[]

  @@index([payslipId])
  @@index([taxRuleVersionId])
}

model TaskTemplate {
  id          BigInt     @id @default(autoincrement())
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  key         String     @unique
  title       String
  description String?
  // 상대 기한 규칙. 형식은 팀 결정 사항(미정). 예: "END_OF_MONTH_AFTER_JOIN"
  dueRule     String
  tasks       UserTask[]
}

model UserTask {
  id         BigInt        @id @default(autoincrement())
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)
  userId     BigInt
  templateId BigInt
  // 점검 결과에서 생성된 할 일이면 연결. 일반 입사 후 할 일이면 null.
  findingId  BigInt?
  status     TaskStatus    @default(TODO)
  dueOn      DateTime?     @db.Date
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  template   TaskTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  finding    CheckFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@unique([userId, templateId])
  @@index([findingId])
}
